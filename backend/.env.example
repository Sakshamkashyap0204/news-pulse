# HTTP server
PORT=4000

# Allowed browser origin for CORS.
# In production, set this to your Vercel frontend URL, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Database — required. The server will not start without this.
MONGODB_URI=mongodb://localhost:27017/news_pulse
MONGODB_DATABASE=news_pulse

# Python ingestion subprocess
# On Linux/Docker the executable is python3; locally on Windows it is usually python.
PYTHON_PATH=python
SCRAPER_PATH=../scraper/main.py
SCRAPER_WORKING_DIRECTORY=../scraper
INGESTION_TIMEOUT_MS=300000
