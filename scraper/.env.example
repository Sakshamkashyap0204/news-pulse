# Database connection. Replace with your own local or Atlas URI.
MONGODB_URI=mongodb://localhost:27017/news_pulse
MONGODB_DATABASE=news_pulse

# Network timeouts for RSS fetching and article extraction.
RSS_REQUEST_TIMEOUT_SECONDS=15
EXTRACTION_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=0.3

# Topic clustering thresholds.
# An article joins an existing cluster only when BOTH conditions are met:
#   - shared keyword count >= MIN_SHARED_KEYWORDS
#   - Jaccard similarity >= MIN_JACCARD_SIMILARITY
MIN_SHARED_KEYWORDS=3
MIN_JACCARD_SIMILARITY=0.20

# Number of top keywords used to generate a cluster label.
MAX_CLUSTER_LABEL_WORDS=3
